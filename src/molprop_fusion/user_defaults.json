{
  "models": {
    "xgboost": {
      "common": {
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "min_child_weight": 1.0,
        "reg_alpha": 0.0,
        "reg_lambda": 1.0,
        "max_bin": 256
      },
      "by_dataset": {
        "user": {
          "max_depth": 4,
          "learning_rate": 0.1,
          "n_estimators": 300
        }
      }
    },
    "catboost": {
      "iterations": 300,
      "depth": 7,
      "learning_rate": 0.05,
      "l2_leaf_reg": 3.0,
      "loss_function": "RMSE",
      "verbose": false
    },
    "lightgbm": {
      "n_estimators": 300,
      "num_leaves": 31,
      "max_depth": -1,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "reg_lambda": 1.0,
      "verbosity": -1
    },
    "extratrees": {
      "n_estimators": 500,
      "max_features": "sqrt",
      "min_samples_leaf": 1,
      "bootstrap": false
    },
    "graph": {
      "family": "CoMPT",
      "hidden_width": 256,
      "layers": 3,
      "attention_heads": 4,
      "dropout": 0.0
    },
    "fusion": {
      "model": "StandardScaler_then_Ridge",
      "alpha": 10.0,
      "fit_intercept": true
    }
  },
  "graph_training": {
    "warmup_epochs": 30,
    "max_epochs": 150,
    "patience": 20,
    "batch_size": 32,
    "weight_decay": 0.0
  },
  "datasets": {
    "user": {
      "url": "https://deepchemdata.s3-us-west-1.amazonaws.com/datasets/delaney-processed.csv",
      "filename": "delaney-processed.csv",
      "sha256": "8c06a76f0c6487d29ab0f903e6a7a7139f189ab3c1178f159c8be8964602f189",
      "rows": 1128,
      "smiles_column": "smiles",
      "target_column": "measured log solubility in mols per litre",
      "units": "log_mol_per_litre",
      "max_atoms": 100,
      "warmup_factor": 0.1
    }
  }
}
